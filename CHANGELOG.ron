    (
      version: (0, 1, 0),
      released: Some("2026-08-23T00:00:00Z"),
      introduction: None,
      references: {},
      changes: {
        "Added": [
          (
            text: "`embed!` compiles the generated attribution into the binary from `OUT_DIR`, and `Attribution`, `Package`, `Licence` and `Origin` model it at run time with no dependencies",
            commit: None,
            aliases: [
              "kevinmatthes",
              "claude",
            ],
          ),
          (
            text: "plain-text and `Markdown` rendering of the attribution",
            commit: None,
            aliases: [
              "kevinmatthes",
              "claude",
            ],
          ),
          (
            text: "the `build` feature: `Builder` resolves the dependency graph over normal and build dependencies, filtered to the target triple and the enabled features and excluding dev-dependencies, discovers each package\'s licence files, classifies how completely they cover the declared SPDX expression, and surveys the copyleft obligations",
            commit: None,
            aliases: [
              "kevinmatthes",
              "claude",
            ],
          ),
          (
            text: "the `build` feature writes both the embedded blob and a committed, human-readable `THIRDPARTY.md`, so drift is a reviewable diff and CI can fail on it",
            commit: None,
            aliases: [
              "kevinmatthes",
              "claude",
            ],
          ),
          (
            text: "the `clap` feature: a flattenable `LicenceArgs` contributing `--licences` and `--licences <CRATE>`, and a `LicenceCommand` subcommand, for host applications built with `clap`",
            commit: None,
            aliases: [
              "kevinmatthes",
              "claude",
            ],
          ),
          (
            text: "the licence copy the upstream author distributed is preferred, falling back to the canonical SPDX text, with the provenance of every text recorded",
            commit: None,
            aliases: [
              "kevinmatthes",
              "claude",
            ],
          ),
          (
            text: "a hard build failure when a notice-style licence ships no text and its mandatory copyright line cannot be recovered; standard-text licences only warn",
            commit: None,
            aliases: [
              "kevinmatthes",
              "claude",
            ],
          ),
          (
            text: "a build-time survey classifying every dependency by copyleft strength and naming the obligation each triggers, with the source-availability pointers the tool can supply",
            commit: None,
            aliases: [
              "kevinmatthes",
              "claude",
            ],
          ),
        ],
      },
    ),
