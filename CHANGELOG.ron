      changes: {
        "Added": [
          (
            text: "the `compression` feature: `embed_compressed!` and the `CompressedAttribution`, `CompressedPackage` and `CompressedLicence` types embed the licence texts deflated, leaving the mandatory notices uncompressed",
            commit: None,
